# shellcheck shell=sh disable=SC2034

# The model is a command-line argument (`--llm provider:model`), not an environment variable.
# pydantic-ai reads the provider key for that model from the environment.

# --llm openai:gpt-4o
# OPENAI_API_KEY=sk-...

# --llm anthropic:claude-sonnet-4-5
# ANTHROPIC_API_KEY=...

# --llm google-gla:gemini-2.5-flash
# GOOGLE_API_KEY=...

# --llm groq:llama-3.3-70b-versatile
# GROQ_API_KEY=...

# --llm ollama:llama3.2
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --llm gateway/openai:gpt-5.6-luna
# PYDANTIC_AI_GATEWAY_API_KEY=...

# --llm bedrock:openai.gpt-oss-120b-1:0
# AWS credentials come from the usual boto3 chain (env, profile, etc.)

# SOLVER_LOGLEVEL=INFO
